# Sao chép thành deploy/.env rồi đổi giá trị. KHÔNG commit file .env.
# Danh sách biến theo Consistency Conventions "Cấu hình" của spine.

# Superuser của image db, chỉ dùng khi khởi tạo volume lần đầu
POSTGRES_PASSWORD=doi-mat-khau-postgres
# Mật khẩu 4 role database (AD-5); init.sql đọc bằng \getenv
DB_OWNER_PASSWORD=doi-mat-khau-owner
DB_BACKEND_PASSWORD=doi-mat-khau-backend
DB_SYNC_PASSWORD=doi-mat-khau-sync
DB_AI_PASSWORD=doi-mat-khau-ai
# Cổng database mở ra máy (đổi nếu máy đã có PostgreSQL chạy ở 5432)
DB_HOST_PORT=5432

# Khóa ký JWT HS256: chuỗi UTF-8 từ 32 byte trở lên, dùng chung backend và ai-service (AD-9)
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-byte
# Giá trị header X-Service-Key cho change-feed /internal (AD-9, AD-12)
INTERNAL_SERVICE_KEY=doi-thanh-chuoi-ngau-nhien

# Khóa Gemini của Đơn vị vận hành, chỉ ai-service dùng. Để trống thì Hỏi đáp dữ liệu báo không sẵn sàng.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Ngày neo cho dữ liệu mẫu (AD-18), định dạng yyyy-MM-dd. Để trống = 2026-12-16, ngày neo của eval/answers/expected.json.
# Đặt bằng ngày demo để dữ liệu trông mới, rồi chạy lại: py -3.14 eval/answers/compute_answers.py --anchor <ngày>
SEED_ANCHOR_DATE=
