  "panels": [
    {
      "id": 1,
      "title": "PostgreSQL đang thu",
      "description": "Số node PostgreSQL mà exporter kết nối được. Cụm nghiệp vụ có 3 node và kho báo cáo có 1 node.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banhang-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có mẫu"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_up == 1)",
