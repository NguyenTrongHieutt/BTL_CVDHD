{
  "title": "Tổng quan vận hành",
  "uid": "banhang-overview",
  "schemaVersion": 40,
  "version": 2,
  "editable": false,
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "banhang",
    "prometheus"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Mục đang thu",
      "description": "Số target Prometheus thu được số liệu.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banhang-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Chưa có mẫu"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up == 1)",
          "legendFormat": "Đang thu",
          "datasource": {
            "type": "prometheus",
            "uid": "banhang-prometheus"
          },
          "editorMode": "code",
          "instant": true,
          "range": false
        }
      ]
    },
    {
