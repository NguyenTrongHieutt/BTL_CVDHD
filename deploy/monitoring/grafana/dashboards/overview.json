    {
      "id": 5,
      "title": "Yêu cầu theo bản API",
      "description": "Tốc độ yêu cầu nghiệp vụ theo địa chỉ bản API nội bộ.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banhang-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Chưa có mẫu"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"backend\",uri=~\"/api/.*\"}[$__rate_interval]))",
          "legendFormat": "API {{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "banhang-prometheus"
          },
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 6,
      "title": "Tỷ lệ HTTP 5xx của API",
      "description": "Tỷ lệ lỗi máy chủ trong số yêu cầu API. Không có mẫu khi không có yêu cầu.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "banhang-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "Chưa có mẫu",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=~\"/api/.*\",status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=~\"/api/.*\"}[$__rate_interval]))) / (sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=~\"/api/.*\"}[$__rate_interval])) > 0)",
          "legendFormat": "Lỗi 5xx",
          "datasource": {
            "type": "prometheus",
            "uid": "banhang-prometheus"
          },
          "editorMode": "code",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 7,
      "title": "Độ trễ p95 API",
